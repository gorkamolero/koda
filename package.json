{
  "name": "koda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "app": "node scripts/run.mjs app",
    "app:built": "node scripts/run.mjs built",
    "verify:clean": "node scripts/run.mjs verify-clean",
    "dev": "turbo run dev",
    "collab:deploy": "node scripts/run.mjs collab-deploy",
    "storybook:deploy": "pnpm --filter @koda/ui deploy-storybook",
    "storybook:pages": "node scripts/publish-storybook-pages.mjs",
    "build": "turbo run build",
    "test": "turbo run test --filter=!e2e",
    "lint": "turbo run lint",
    "desktop": "node scripts/run.mjs app",
    "sidecar": "node scripts/run.mjs sidecar",
    "storybook": "pnpm --filter @koda/ui storybook",
    "build-storybook": "pnpm --filter @koda/ui build-storybook",
    "test-storybook": "pnpm --filter @koda/ui test-storybook"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  }
}
