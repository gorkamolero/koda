# Copy to .env.local. pnpm app and pnpm sidecar load this file automatically.
# Hosted mode needs no Liveblocks key. Set this URL or use Settings → Collaboration.
# The build default stays empty until the owner deploys the service.
KODA_COLLAB_URL=

# Optional development/self-host mode: overrides the hosted service when set.
# Never prefix the secret with VITE_ or distribute it to collaborators.
LIVEBLOCKS_SECRET_KEY=

# Codex uses your existing `codex login` session. Choose its model in Koda.

# Optional: separate each Koda instance's data and identity.
# KODA_DATA_DIR=/absolute/path/to/koda-data
# KODA_HTTP_PORT=3847
# KODA_SOCKET=/absolute/path/to/koda-data/koda.sock
