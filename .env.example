# Copy to .env.local. pnpm app and pnpm sidecar load this file automatically.
# Secrets remain on the sidecar; do not prefix this variable with VITE_.
LIVEBLOCKS_SECRET_KEY=

# Codex uses your existing `codex login` session. Choose its model in Koda.

# Optional: separate each Koda instance's data and identity.
# KODA_DATA_DIR=/absolute/path/to/koda-data
# KODA_HTTP_PORT=3847
# KODA_SOCKET=/absolute/path/to/koda-data/koda.sock
