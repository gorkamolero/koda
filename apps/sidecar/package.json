{
  "name": "@koda/sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js orchestration sidecar for Koda",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
    "dev": "tsx src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@liveblocks/client": "^3.13.3",
    "@liveblocks/node": "^3.13.3",
    "@openai/codex-sdk": "^0.161.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.1",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.1",
    "superjson": "^2.2.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "yjs": "^13.6.29",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.29",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
