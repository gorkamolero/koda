{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:proof": "playwright test --config proof.config.ts",
    "typecheck:proof": "tsc --noEmit -p tsconfig.proof.json",
    "test:proof:codex": "playwright test --config proof.config.ts codex-proof.spec.ts",
    "test:proof:claude": "playwright test --config proof.config.ts claude-proof.spec.ts",
    "test:proof:collaboration": "playwright test --config proof.config.ts collaboration-proof.spec.ts",
    "record:two-machine": "playwright test --config two-machine.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
